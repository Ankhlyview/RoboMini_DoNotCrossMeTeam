<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robomini_vision</name>
  <version>0.1.0</version>
  <description>
    Traditional-vision auto-aim for the ROBOMINI energy rune in the robomini_sim
    Gazebo simulation: HSV light-bar detection, pending/active classification,
    ray-plane pose estimation, ballistic gimbal aiming and automatic firing.
  </description>
  <maintainer email="algorithm-a@robomini.local">Algorithm_A</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>robomini_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
